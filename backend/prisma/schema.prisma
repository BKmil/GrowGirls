generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  heightCm     Float?
  weightKg     Float?
  birthDate    DateTime?
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
}